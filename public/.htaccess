<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/* requests to PHP MySQL API
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

  # Do not rewrite existing files or directories (images, assets, sw.js, manifest)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to React PWA index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Fast loading on low-bandwidth mobile networks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
